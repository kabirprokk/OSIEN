rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public lab build: anyone authed (incl. anonymous) can read;
    // writes allowed for match logs + global Elo. Tighten later with App Check.
    match /matches/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['round','winner','moves','mode','seed'])
        && request.resource.data.round is int
        && request.resource.data.winner in ['O','X','DRAW'];
      allow update, delete: if false;
    }
    match /leaderboard/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
