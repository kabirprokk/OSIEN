# Supabase public client configuration. Never put the database password here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
MAPTILER_KEY=your-maptiler-public-key
# Firebase push (background notifications). Empty = push stays inert, build-safe.
# From Firebase Console > Project settings > Your Android app.
FCM_SENDER_ID=
FCM_API_KEY=
FCM_PROJECT_ID=
FCM_APP_ID=
